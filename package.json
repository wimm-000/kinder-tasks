{
  "name": "kinder-tasks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "pnpm dev",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:server": "TURSO_DATABASE_URL=file:e2e.db APP_URL=http://127.0.0.1:5174 pnpm db:migrate && TURSO_DATABASE_URL=file:e2e.db APP_URL=http://127.0.0.1:5174 pnpm db:seed && TURSO_DATABASE_URL=file:e2e.db APP_URL=http://127.0.0.1:5174 pnpm dev --host 127.0.0.1 --port 5174",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/app-icon.svg"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.29",
    "@hookform/resolvers": "5.9.0",
    "@js-temporal/polyfill": "0.5.1",
    "@libsql/client": "0.17.4",
    "@radix-ui/react-slot": "1.3.3",
    "@react-router/node": "^7.18.2",
    "better-auth": "1.6.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "isbot": "^5.1.43",
    "lucide-react": "1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.85.0",
    "react-router": "^7.18.2",
    "tailwind-merge": "3.6.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@netlify/vite-plugin": "^2.12.8",
    "@netlify/vite-plugin-react-router": "^3.1.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "^7.18.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "1.0.2",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.15",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
